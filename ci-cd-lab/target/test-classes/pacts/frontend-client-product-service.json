{
  "consumer": {
    "name": "frontend-client"
  },
  "interactions": [
    {
      "description": "a request for product 1",
      "providerStates": [
        {
          "name": "product 1 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/products/1"
      },
      "response": {
        "body": {
          "id": 1,
          "name": "Laptop",
          "price": 999.99
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.9"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "product-service"
  }
}
